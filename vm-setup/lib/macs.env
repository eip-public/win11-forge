# Single source of truth for win11-forge VM MAC addresses.
#
# KVM uses QEMU OUI 52:54:00; VMware uses VMware OUI 00:50:56. The
# single-VM gold-build path reuses KVM_TARGET_MAC because the lab
# target VM is the gold image with a fresh overlay — same MAC.
#
# := lets environment overrides win at source time.
: "${KVM_TARGET_MAC:=52:54:00:11:11:11}"
: "${KVM_DEBUGGER_MAC:=52:54:00:22:22:22}"
: "${VMWARE_TARGET_MAC:=00:50:56:11:11:11}"
: "${VMWARE_DEBUGGER_MAC:=00:50:56:22:22:22}"
